{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/px/static/:path(.*)", "destination": "https://us-assets.i.posthog.com/static/:path" },
    { "source": "/px/array/:path(.*)", "destination": "https://us-assets.i.posthog.com/array/:path" },
    { "source": "/px/:path(.*)", "destination": "https://us.i.posthog.com/:path" }
  ]
}
