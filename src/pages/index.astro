---
import Layout from '../layouts/Layout.astro';

const email = 'pedroestevez001@gmail.com';
const hireMailto = `mailto:${email}?subject=${encodeURIComponent('Hiring inquiry — Business Analyst role')}`;
const quoteMailto = (svc: string) =>
  `mailto:${email}?subject=${encodeURIComponent(`Quote request — ${svc}`)}`;

const nav = [
  { href: '#about', label: 'about' },
  { href: '#experience', label: 'experience' },
  { href: '#skills', label: 'skills' },
  { href: '#ai', label: 'ai_projects' },
  { href: '#services', label: 'services' },
  { href: '#contact', label: 'contact' },
];

const stats = [
  { value: '$20K', unit: '/yr', label: 'invoicing automation savings' },
  { value: '$15K', unit: '/yr', label: 'at-risk contract rescued' },
  { value: '$5K', unit: '/yr', label: 'logistics cost removed' },
  { value: '8+', unit: 'yrs', label: 'business analysis' },
  { value: '3', unit: 'langs', label: 'EN · ES · PT fluent' },
];

const experience = [
  {
    dates: '2026.04 — 2026.07',
    company: 'Florida Power & Light',
    role: 'Business Analyst II · Contract',
    chips: ['GCP', 'Power Automate'],
    points: [
      'Led a GCP adoption enablement program built from scratch, coordinating training across teams.',
      'Automated the program’s own workflows with Power Automate.',
      'Recognized by management inside a 3-month engagement.',
    ],
  },
  {
    dates: '2024.04 — 2026.03',
    company: 'United Data Technologies',
    role: 'Business Analyst',
    chips: ['−$20K/yr', '+$15K/yr', '−$5K/yr'],
    points: [
      'Automated customer invoicing for an entire business unit: Excel prototype → Power BI paginated reports + SQL integration, eliminating $20K/yr in manual cost.',
      'Rescued a $15K/yr at-risk contract with a rapid-turnaround Power BI dashboard.',
      'Authored the company-wide data strategy roadmap and the org-wide ERD.',
      'Redesigned reverse-logistics routing, removing $5K/yr in cost.',
    ],
  },
  {
    dates: '2019.05 — 2024.02',
    company: 'Independent Purchasing Cooperative',
    role: 'Three roles · Subway supply chain',
    chips: ['Excel/VBA', 'Tableau', 'MDM'],
    points: [
      'Business Data Analyst — automated a multi-language legal-compliance system in Excel/VBA + Power Query, documented end-to-end in Visio.',
      'Project Manager — led an MDM vendor transition and product-managed the internal PM platform.',
      'Supply Chain Data Steward — supply chain data SME; automated Tableau reporting.',
    ],
  },
  {
    dates: '2017.12 — 2019.02',
    company: 'Wythe Capital Trust',
    role: 'Data Analyst',
    chips: ['Selenium', 'SQL'],
    points: [
      'Built end-to-end data pipelines with Selenium-automated extraction.',
      'SQL + statistical analysis to target real-estate leads.',
    ],
  },
];

const skillGroups = [
  {
    name: 'BI & Reporting',
    items: ['Power BI (incl. paginated reports)', 'Tableau', 'Excel — expert', 'Power Query', 'VBA'],
  },
  {
    name: 'Data & Programming',
    items: ['SQL — expert', 'Python', 'Data modeling & ERDs', 'Data governance'],
  },
  {
    name: 'Automation & AI',
    items: ['Power Automate', 'Claude / Claude Code — AI-assisted development', 'Agentic system design', 'Selenium'],
  },
  {
    name: 'Delivery',
    items: ['Scrum · Jira · Linear', 'Requirements engineering', 'UAT', 'Process mapping'],
  },
];

const services = [
  {
    code: 'CLN',
    name: 'Data Cleanup',
    price: 'from $400',
    desc: 'One messy dataset in, one trustworthy dataset out.',
    points: [
      'Duplicate removal & missing-value review',
      'Formatting fixes & category standardization',
      'Validation checks across the full file',
      'Cleaned Excel/CSV + summary of corrections',
    ],
  },
  {
    code: 'ANQ',
    name: 'Business Question Analysis',
    price: 'from $750',
    desc: 'One clearly defined question, answered end-to-end on one dataset.',
    points: [
      'Data prep + exploratory analysis',
      'Key calculations behind the answer',
      'Up to 5 visualizations',
      'Written findings summary',
    ],
  },
  {
    code: 'DSH',
    name: 'Interactive Dashboard',
    price: 'from $1,200',
    desc: 'Power BI, Tableau, Looker Studio, or Excel — your stack.',
    points: [
      'Designed dashboard with basic filters',
      '1 revision round included',
      'Usage guide + virtual walkthrough',
    ],
  },
  {
    code: 'REC',
    name: 'Insights & Recommendations',
    price: 'from $500',
    priceNote: 'as an add-on to any analysis',
    desc: 'Turn a completed analysis into decisions leadership can act on.',
    points: [
      'Executive summary',
      'Prioritized recommendations',
      'Risks & next steps',
    ],
  },
  {
    code: 'URG',
    name: 'Urgent Investigation',
    price: 'from $750',
    desc: 'Something unexpected broke, or the question can’t wait.',
    points: [
      'Focused consultation on the problem',
      'Up to 2 datasets investigated',
      'Findings document + virtual presentation',
      'Larger scope? Quoted as a second phase — never hourly',
    ],
  },
  {
    code: 'FUL',
    name: 'Complete Business Insights',
    price: '$2,500',
    priceNote: 'with dashboard — from $3,500',
    desc: 'The full loop: clean, analyze, recommend.',
    points: [
      'Cleaning of a primary dataset',
      'Up to 3 business questions answered',
      'Executive report + prioritized recommendations',
    ],
  },
];
---

<Layout>
  <!-- ===== NAV ===== -->
  <header class="fixed inset-x-0 top-0 z-50 border-b border-line-soft bg-harbor/85 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
      <a href="#top" class="flex items-center gap-2.5 font-display text-lg tracking-tight text-chalk">
        PE<span aria-hidden="true" class="inline-block h-4 w-2 bg-amber"></span>
      </a>
      <nav aria-label="Sections" class="hidden items-center gap-6 md:flex">
        {nav.map((n) => (
          <a
            href={n.href}
            class="font-mono text-[13px] text-mist transition-colors hover:text-amber"
          >{n.label}</a>
        ))}
      </nav>
      <a
        href={hireMailto}
        class="hidden rounded-sm bg-amber px-4 py-2 font-mono text-[13px] font-semibold text-harbor transition-colors hover:bg-amber-soft md:inline-block"
      >hire_me</a>
      <a
        href="#contact"
        class="font-mono text-[13px] text-amber md:hidden"
      >contact →</a>
    </div>
  </header>

  <main id="top">
    <!-- ===== HERO ===== -->
    <section class="plot-grid relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-24">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <p class="eyebrow">Miami, FL · 25.76°N 80.19°W</p>
          <h1 class="mt-5 font-display text-[clamp(3rem,9vw,5.5rem)] leading-[0.95] tracking-tight uppercase">
            Pedro<br />Estevez<span aria-hidden="true" class="cursor-blink ml-2 inline-block h-[0.72em] w-[0.42em] bg-amber align-baseline"></span>
          </h1>
          <p class="mt-6 font-mono text-sm font-medium tracking-wide text-amber uppercase">
            Business Analyst · Data &amp; AI Automation
          </p>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-mist">
            I turn messy operations into <span class="text-chalk">automated, measurable systems</span> —
            prototyped fast, shipped in the tools your team already runs, and priced by what they save.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={hireMailto}
              class="rounded-sm bg-amber px-6 py-3 font-mono text-sm font-semibold text-harbor transition-colors hover:bg-amber-soft"
            >Hire me</a>
            <a
              href="#services"
              class="rounded-sm border border-line px-6 py-3 font-mono text-sm font-medium text-chalk transition-colors hover:border-amber hover:text-amber"
            >Work with me ↓</a>
          </div>

          <p class="mt-8 inline-flex items-center gap-2.5 rounded-full border border-delta/40 bg-delta/10 px-4 py-1.5 font-mono text-[13px] text-delta">
            <span class="pulse-dot inline-block h-2 w-2 rounded-full bg-delta"></span>
            Available immediately — contract or full-time
          </p>
        </div>

        <!-- signature: site telemetry panel -->
        <aside aria-label="Site telemetry" class="reveal">
          <div class="rounded-md border border-line bg-panel-2/90 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.6)]">
            <div class="flex items-center justify-between border-b border-line px-5 py-3">
              <span class="eyebrow !text-[11px]">site_telemetry</span>
              <span class="font-mono text-[11px] text-dim">rev 1.0</span>
            </div>
            <dl class="divide-y divide-line-soft font-mono text-[13px]">
              <div class="flex items-center justify-between px-5 py-3.5">
                <dt class="text-dim">built_with</dt>
                <dd class="text-chalk">Claude Code</dd>
              </div>
              <div class="flex items-center justify-between px-5 py-3.5">
                <dt class="text-dim">prompts_used</dt>
                <dd class="text-chalk">1</dd>
              </div>
              <div class="flex items-center justify-between px-5 py-3.5">
                <dt class="text-dim">build_time</dt>
                <dd class="text-amber">&lt; 60 min</dd>
              </div>
              <div class="flex items-center justify-between px-5 py-3.5">
                <dt class="text-dim">stack</dt>
                <dd class="text-chalk">Astro + Tailwind</dd>
              </div>
              <div class="flex items-center justify-between px-5 py-3.5">
                <dt class="text-dim">status</dt>
                <dd class="flex items-center gap-2 text-delta">
                  <span class="inline-block h-1.5 w-1.5 rounded-full bg-delta"></span>live
                </dd>
              </div>
            </dl>
            <p class="border-t border-line px-5 py-3 font-mono text-[11px] text-dim">
              // this page is the demo — see <a href="#ai" class="text-amber hover:underline">ai_projects</a>
            </p>
          </div>
        </aside>
      </div>
    </section>

    <!-- ===== STATS STRIP ===== -->
    <section aria-label="Impact statistics" class="border-y border-line bg-panel-2/60">
      <div class="mx-auto grid max-w-6xl grid-cols-2 divide-line-soft px-5 sm:px-8 md:grid-cols-5 md:divide-x">
        {stats.map((s, i) => (
          <div class:list={['px-2 py-7 md:px-6', i === stats.length - 1 && 'col-span-2 md:col-span-1']}>
            <p class="font-display text-3xl tracking-tight text-amber">
              {s.value}<span class="ml-1 font-mono text-sm font-medium text-dim">{s.unit}</span>
            </p>
            <p class="mt-1.5 font-mono text-[11px] tracking-wider text-mist uppercase">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section id="about" class="py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 sm:px-8 lg:grid-cols-[1fr_0.8fr]">
        <div class="reveal">
          <p class="eyebrow">about</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Analyst by title.<br />Systems builder by habit.
          </h2>
          <div class="mt-6 space-y-4 text-[17px] leading-relaxed text-mist">
            <p>
              Eight-plus years across <span class="text-chalk">utilities, supply chain, and finance
              operations</span> — always in the same seat: the person who finds the manual process
            bleeding money and replaces it with a system that runs itself and proves it with numbers.
            </p>
            <p>
              My pattern is consistent: <span class="text-chalk">prototype in Excel</span> to get the logic
              right fast, <span class="text-chalk">implement in Power BI and Power Automate</span> so it
              scales, then <span class="text-chalk">drive adoption</span> so the fix actually sticks.
            </p>
            <p>
              Now AI-enabled: I build working software with <span class="text-chalk">Claude Code</span> and
              design <span class="text-chalk">agentic systems</span> that turn well-written requirements
              directly into shipped tools.
            </p>
          </div>
        </div>
        <div class="reveal">
          <div class="rounded-md border border-line bg-panel p-6">
            <p class="eyebrow !text-[11px]">operating_mode</p>
            <ol class="mt-5 space-y-4 font-mono text-sm">
              <li class="flex items-baseline gap-3">
                <span class="text-amber">01</span>
                <span class="text-chalk">Prototype in Excel — logic first, fast</span>
              </li>
              <li class="flex items-baseline gap-3">
                <span class="text-amber">02</span>
                <span class="text-chalk">Implement in Power BI / Power Automate</span>
              </li>
              <li class="flex items-baseline gap-3">
                <span class="text-amber">03</span>
                <span class="text-chalk">Drive adoption until it sticks</span>
              </li>
              <li class="flex items-baseline gap-3">
                <span class="text-amber">04</span>
                <span class="text-chalk">Measure the savings, in dollars</span>
              </li>
            </ol>
            <div class="mt-6 border-t border-line-soft pt-5">
              <p class="font-mono text-[11px] tracking-wider text-dim uppercase">languages — fluent</p>
              <div class="mt-3 flex gap-2">
                {['English', 'Español', 'Português'].map((l) => (
                  <span class="rounded-sm border border-line px-3 py-1 font-mono text-xs text-mist">{l}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== EXPERIENCE ===== -->
    <section id="experience" class="border-t border-line-soft py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="reveal">
          <p class="eyebrow">experience</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">The track record</h2>
        </div>
        <div class="mt-12 space-y-0">
          {experience.map((job) => (
            <article class="reveal group grid gap-3 border-t border-line-soft py-8 last:border-b md:grid-cols-[190px_1fr] md:gap-10">
              <div class="font-mono text-[13px] text-dim">
                <p class="text-amber">{job.dates}</p>
                <div class="mt-2 flex flex-wrap gap-1.5 md:flex-col md:items-start">
                  {job.chips.map((c) => (
                    <span
                      class:list={[
                        'rounded-sm border px-2 py-0.5 text-[11px]',
                        /^[−+]\$/.test(c)
                          ? 'border-delta/40 bg-delta/10 text-delta'
                          : 'border-line text-mist',
                      ]}
                    >{c}</span>
                  ))}
                </div>
              </div>
              <div>
                <h3 class="text-xl font-bold text-chalk">
                  {job.company}
                  <span class="ml-2 font-mono text-sm font-normal text-mist">· {job.role}</span>
                </h3>
                <ul class="mt-4 space-y-2.5">
                  {job.points.map((p) => (
                    <li class="flex gap-3 text-[15px] leading-relaxed text-mist">
                      <span aria-hidden="true" class="mt-[0.55em] h-px w-4 flex-none bg-amber/70"></span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== SKILLS ===== -->
    <section id="skills" class="border-t border-line-soft bg-panel-2/40 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="reveal">
          <p class="eyebrow">skills</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">The toolkit</h2>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {skillGroups.map((g) => (
            <div class="reveal rounded-md border border-line bg-panel p-6">
              <h3 class="font-mono text-[13px] font-semibold tracking-wider text-amber uppercase">{g.name}</h3>
              <ul class="mt-4 space-y-2.5">
                {g.items.map((item) => (
                  <li class="flex gap-2.5 text-sm leading-snug text-mist">
                    <span aria-hidden="true" class="mt-[0.45em] h-1 w-1 flex-none rounded-full bg-amber/70"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="reveal mt-6 grid gap-5 sm:grid-cols-2">
          <div class="rounded-md border border-line bg-panel p-6">
            <h3 class="font-mono text-[13px] font-semibold tracking-wider text-amber uppercase">Certifications</h3>
            <p class="mt-3 text-sm leading-relaxed text-mist">
              Microsoft Azure Fundamentals (AZ-900) · Microsoft Azure Data Fundamentals (DP-900)
            </p>
          </div>
          <div class="rounded-md border border-line bg-panel p-6">
            <h3 class="font-mono text-[13px] font-semibold tracking-wider text-amber uppercase">Education</h3>
            <p class="mt-3 text-sm leading-relaxed text-mist">
              BBA, Management Information Systems — Florida International University ·
              Project Management MicroMasters — RIT
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== AI PROJECTS ===== -->
    <section id="ai" class="border-t border-line-soft py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="reveal">
          <p class="eyebrow">ai_projects</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Requirements in.<br />Working software out.
          </h2>
        </div>
        <div class="mt-12 grid gap-5 lg:grid-cols-2">
          <article class="reveal rounded-md border border-line bg-panel p-7 transition-colors hover:border-amber/60">
            <p class="font-mono text-[11px] tracking-wider text-dim uppercase">agentic system · human-gated</p>
            <h3 class="mt-3 text-xl font-bold text-chalk">Software that builds itself from agile specs</h3>
            <p class="mt-4 text-[15px] leading-relaxed text-mist">
              I author user stories with acceptance criteria in Linear, the way any product team would.
              From there, an AI agent crew picks up each issue, builds the feature, and reports back —
              with a human gate at every merge. The requirements discipline of a Business Analyst,
              executed at machine speed.
            </p>
            <p class="mt-5 font-mono text-[12px] text-dim">
              Linear specs → agent crew → review gate → shipped
            </p>
          </article>
          <article class="reveal rounded-md border border-amber/50 bg-panel p-7 shadow-[0_0_40px_-18px_rgba(255,178,36,0.4)]">
            <p class="font-mono text-[11px] tracking-wider text-amber uppercase">live proof · you're looking at it</p>
            <h3 class="mt-3 text-xl font-bold text-chalk">Functional websites in under an hour</h3>
            <p class="mt-4 text-[15px] leading-relaxed text-mist">
              One structured prompt into Claude Code produces a complete, deployable site — copy,
              design system, responsive build, and metadata included. No template, no drag-and-drop
              builder, no week of back-and-forth.
            </p>
            <p class="mt-5 font-mono text-[13px] font-medium text-amber">
              This site is one of them.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== SERVICES ===== -->
    <section id="services" class="border-t border-line-soft bg-panel-2/40 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="eyebrow">services — fixed scope</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">Productized data services</h2>
          <p class="mt-5 text-[17px] leading-relaxed text-mist">
            Fixed prices for defined outcomes — no hourly billing, no retainers. Send your dataset
            and your question — get back a confirmed price and a delivery date. Prices are starting
            points; final scope is shaped on a free discovery call.
          </p>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {services.map((s) => (
            <article class="reveal flex flex-col rounded-md border border-line bg-panel p-6 transition-colors hover:border-amber/60">
              <div class="flex items-baseline justify-between gap-3">
                <span class="rounded-sm bg-harbor px-2 py-1 font-mono text-[11px] font-semibold tracking-widest text-amber">{s.code}</span>
                <span class="text-right font-mono text-[15px] font-semibold text-chalk">
                  {s.price.startsWith('from') ? <><span class="text-[11px] font-medium text-dim">from </span>{s.price.slice(5)}</> : s.price}
                </span>
              </div>
              {s.priceNote && <p class="mt-1 text-right font-mono text-[11px] text-dim">{s.priceNote}</p>}
              <h3 class="mt-4 text-lg font-bold text-chalk">{s.name}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-dim">{s.desc}</p>
              <ul class="mt-4 flex-1 space-y-2">
                {s.points.map((p) => (
                  <li class="flex gap-2.5 text-sm leading-snug text-mist">
                    <span aria-hidden="true" class="mt-[0.5em] h-px w-3.5 flex-none bg-amber/70"></span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
              <a
                href={quoteMailto(s.name)}
                class="mt-6 inline-block rounded-sm border border-line px-4 py-2 text-center font-mono text-[13px] font-medium text-chalk transition-colors hover:border-amber hover:text-amber"
              >Get a quote →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== CONTACT ===== -->
    <section id="contact" class="plot-grid-up relative border-t border-line-soft py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 text-center">
        <p class="eyebrow reveal justify-center">contact</p>
        <h2 class="reveal mt-5 font-display text-[clamp(2.25rem,6vw,4rem)] leading-[1.02] tracking-tight uppercase">
          Got a messy process?<br /><span class="text-amber">Let's automate it.</span>
        </h2>
        <p class="reveal mx-auto mt-6 max-w-xl text-lg leading-relaxed text-mist">
          Hiring for a role, or holding a dataset that owes you answers — either way, the first
          conversation is free.
        </p>
        <div class="reveal mt-9 flex flex-wrap items-center justify-center gap-4">
          <a
            href={`mailto:${email}`}
            class="rounded-sm bg-amber px-7 py-3.5 font-mono text-sm font-semibold text-harbor transition-colors hover:bg-amber-soft"
          >{email}</a>
          <a
            href="https://linkedin.com/in/pedro-estevez-0827a77a"
            rel="noopener"
            target="_blank"
            class="rounded-sm border border-line px-7 py-3.5 font-mono text-sm font-medium text-chalk transition-colors hover:border-amber hover:text-amber"
          >LinkedIn ↗</a>
        </div>
        <p class="reveal mt-8 font-mono text-[13px] text-dim">
          Miami, FL · working in <span class="text-mist">EN / ES / PT</span> · remote or on-site
        </p>
      </div>
    </section>
  </main>

  <footer class="border-t border-line-soft py-8">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-5 font-mono text-[12px] text-dim sm:flex-row sm:px-8">
      <p>© {new Date().getFullYear()} Pedro Estevez</p>
      <p>built_with Claude Code in &lt; 60 min · <span class="text-amber">this page is the demo</span></p>
    </div>
  </footer>
</Layout>
