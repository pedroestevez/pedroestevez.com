---
import Layout from '../layouts/Layout.astro';

const email = 'pedroestevez001@gmail.com';
const repoUrl = 'https://github.com/pedroestevez/pedroestevez.com';
const hireMailto = `mailto:${email}?subject=${encodeURIComponent('Hiring inquiry — Business Analyst role')}`;
const quoteMailto = (svc: string) =>
  `mailto:${email}?subject=${encodeURIComponent(`Quote request — ${svc}`)}`;

// The booking app — a separate, multi-tenant Next.js + Supabase application,
// deployed once and addressed per tenant by slug. This site links to it; it is
// not embedded here.
const bookingUrl = 'https://booking.aligncompass.com/pedroestevez';
const bookingRepoUrl = 'https://github.com/pedroestevez/Booking-Platform';

// Stated plainly, and kept in step with what the app's own confirmation screen
// says after a booking. A demo that overclaims is worse than one that doesn't.
const bookingWired = [
  'Postgres with row-level security — every row scoped by customer_id',
  'Live availability from weekly rules, in the tenant\'s timezone',
  'A real booking row, held slot, and .ics calendar invite',
  'Multi-tenant by slug — one deploy serves every customer',
];
const bookingNotWired = [
  'Confirmation emails — no provider key, so nobody is notified yet',
  'Online payment — Stripe is the next release',
];

// Quoted character-exact from src/layouts/Layout.astro:44-53 (leading indentation
// normalised). Rendered in a <pre> — do not reformat.
const posthogSnippet = `window.posthog.init(phKey, {
  api_host: phProxy || phHost,
  // With api_host proxied, the SDK can't infer where the PostHog app
  // lives — state it so toolbar/UI links resolve.
  ui_host: phHost.replace('.i.posthog.com', '.posthog.com'),
  persistence: phCookieless ? 'memory' : 'localStorage+cookie',
  person_profiles: 'identified_only',
  capture_pageview: true,
  autocapture: true,
});`;

// Excerpted from docs/ENGINE.md §4 (Development-Engine-Seed) — a spec Pedro wrote.
const routingSpec =
  'Model selection: model = max(points-tier, risk-tier). A 1-point payments task still ' +
  'routes to Opus, runs the security pass, and gets stricter acceptance criteria. Risk ' +
  "floors behavior up — that's how \"needs more care\" is encoded, as gates, not an " +
  'inflated point value.';

const nav = [
  { href: '#about', label: 'about' },
  { href: '#experience', label: 'experience' },
  { href: '#skills', label: 'skills' },
  { href: '#ai', label: 'ai_projects' },
  { href: '#booking', label: 'booking_app' },
  { href: '#services', label: 'services' },
  { href: '#contact', label: 'contact' },
];

const stats = [
  { value: '$20K', unit: '/yr', label: 'invoicing automation savings' },
  { value: '$15K', unit: '/yr', label: 'at-risk contract rescued' },
  { value: '$5K', unit: '/yr', label: 'logistics cost removed' },
  { value: '8+', unit: 'yrs', label: 'business analysis' },
  { value: '3', unit: 'langs', label: 'EN · ES · PT fluent' },
];

// About panel — real shipped artifacts, not process steps.
const shipped = [
  {
    name: 'pedroestevez.com',
    detail: 'Astro 5 + Tailwind 4, first version in one prompt',
  },
  {
    name: 'Development Engine — an agentic build crew',
    detail:
      'specced by me — two human gates: no engine change merges without me, no work runs outside an approved cycle',
  },
  {
    name: 'Org-wide ERD + company-wide data strategy',
    detail: 'United Data Technologies',
  },
  {
    name: 'Selenium extraction pipelines + SQL analysis',
    detail: 'Wythe Capital Trust',
  },
];

const experience = [
  {
    dates: '2026.04 — 2026.07',
    company: 'Florida Power & Light',
    role: 'Business Analyst II · Contract',
    chips: ['GCP', 'Power Automate'],
    points: [
      'Led a GCP adoption enablement program built from scratch, coordinating training across teams — recognized by management inside a three-month engagement.',
      'Automated the program’s own workflows with Power Automate.',
    ],
  },
  {
    dates: '2024.04 — 2026.03',
    company: 'United Data Technologies',
    role: 'Business Analyst',
    chips: ['−$20K/yr', '+$15K/yr', '−$5K/yr'],
    points: [
      'Automated customer invoicing for an entire business unit — SQL integration feeding Power BI paginated reports, logic proven in an Excel prototype first. Eliminated $20K/yr in manual cost.',
      'Rescued a $15K/yr at-risk contract with a rapid-turnaround Power BI dashboard.',
      'Authored the company-wide data strategy roadmap and the org-wide ERD.',
      'Redesigned reverse-logistics routing, removing $5K/yr in cost.',
    ],
  },
  {
    dates: '2019.05 — 2024.02',
    company: 'Independent Purchasing Cooperative',
    role: 'Three roles · Subway supply chain',
    chips: ['Excel/VBA', 'Tableau', 'MDM'],
    points: [
      'Business Data Analyst — automated a multi-language legal-compliance system in Excel/VBA + Power Query, documented end-to-end in Visio.',
      'Project Manager — led an MDM vendor transition and product-managed the internal PM platform.',
      'Supply Chain Data Steward — supply chain data SME; automated Tableau reporting.',
    ],
  },
  {
    dates: '2017.12 — 2019.02',
    company: 'Wythe Capital Trust',
    role: 'Data Analyst',
    chips: ['Selenium', 'SQL'],
    points: [
      'Built end-to-end data pipelines with Selenium-automated extraction.',
      'SQL + statistical analysis to target real-estate leads.',
    ],
  },
];

const skillGroups = [
  {
    name: 'Programming & Data',
    items: [
      'SQL — expert',
      'Python — scripting & data pipelines',
      'Selenium — automated extraction pipelines',
      'Data modeling & ERDs',
      'Data governance',
    ],
  },
  {
    name: 'BI & Reporting',
    items: ['Power BI (incl. paginated reports)', 'Tableau', 'Excel — expert', 'Power Query', 'VBA'],
  },
  {
    name: 'Automation & AI',
    items: [
      'Claude / Claude Code — AI-assisted development',
      'Agentic system design',
      'Power Automate',
    ],
  },
  {
    name: 'Delivery',
    items: ['Scrum · Jira · Linear', 'Requirements engineering', 'UAT', 'Process mapping'],
  },
];

const services = [
  {
    code: 'CLN',
    name: 'Data Cleanup',
    price: 'from $400',
    desc: 'One messy dataset in, one trustworthy dataset out.',
    entry: 'start here — the low-commitment way to see how I work',
