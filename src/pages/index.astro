---

<Layout>
  <!-- ===== NAV ===== -->
  <header class="fixed inset-x-0 top-0 z-50 border-b border-line-soft bg-harbor/85 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 sm:px-8">
      <a href="#top" class="-ml-2 inline-flex min-h-11 items-center gap-2 px-2 font-display text-[17px] tracking-tight text-chalk">
        PE<span aria-hidden="true" class="inline-block h-4 w-2 bg-amber"></span>
      </a>
      <nav aria-label="Sections" class="hidden items-center gap-6 md:flex">
        {nav.map((n) => (
          <a
            href={n.href}
            class="inline-flex min-h-11 items-center px-2 font-mono text-[13px] text-mist transition-colors hover:text-amber"
          >{n.label}</a>
        ))}
      </nav>
      <a
        href={hireMailto}
        class="cta-primary hidden min-h-11 items-center justify-center rounded-sm bg-amber px-4 py-2 font-mono text-[13px] font-semibold text-harbor md:inline-flex"
      >hire_me</a>
      <a
        href="#contact"
        class="inline-flex min-h-11 items-center px-2 font-mono text-[13px] text-amber md:hidden"
      >contact →</a>
    </div>
  </header>

  <main id="top">
    <!-- ===== HERO ===== -->
    <section class="plot-grid relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-24">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 sm:px-8 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <p class="eyebrow">Miami, FL · 25.76°N 80.19°W</p>
          <h1 class="mt-6 font-display text-[clamp(3rem,9vw,5.5rem)] leading-[0.95] tracking-tight uppercase">
            Pedro<br />Estevez<span aria-hidden="true" class="cursor-blink ml-2 inline-block h-[0.72em] w-[0.42em] bg-amber align-baseline"></span>
          </h1>
          <p class="mt-6 font-mono text-sm font-medium tracking-wide text-amber uppercase">
            Business Analyst · SQL · Python · AI Automation
          </p>
          <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-mist">
            I turn messy operations into <span class="text-chalk">systems that run themselves and
            prove it in dollars</span> — I write the SQL and the Python, design the agents that do
            the rest, and ship it in the tools your team already runs.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={hireMailto}
              class="cta-primary inline-flex min-h-11 items-center rounded-sm bg-amber px-6 py-4 font-mono text-sm font-semibold text-harbor"
            >Hire me</a>
            <a
              href="#services"
              class="inline-flex min-h-11 items-center font-mono text-[13px] text-mist underline-offset-4 transition-colors hover:text-amber hover:underline"
            >or see fixed-scope data projects ↓</a>
          </div>

          <p class="mt-8 inline-flex items-center gap-2 rounded-full border border-delta/40 bg-delta/10 px-4 py-1.5 font-mono text-[13px] text-delta">
            <span class="pulse-dot inline-block h-2 w-2 rounded-full bg-delta"></span>
            Available immediately — contract or full-time
          </p>
        </div>

        <!-- signature: site telemetry panel -->
        <aside aria-label="Site telemetry" class="reveal">
          <div class="rounded-md border border-line bg-panel-2/90 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.6)]">
            <div class="flex items-center justify-between gap-4 border-b border-line px-6 py-4">
              <span class="eyebrow">site_telemetry</span>
              <span class="font-mono text-[13px] text-dim">rev 1.1</span>
            </div>
            <dl class="divide-y divide-line-soft font-mono text-[13px]">
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">built_with</dt>
                <dd class="text-chalk">Claude Code</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">initial_prompts</dt>
                <dd class="text-chalk">1</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">initial_build</dt>
                <dd class="text-amber">&lt; 60 min</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">stack</dt>
                <dd class="text-chalk">Astro 5 · Tailwind 4</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">analytics</dt>
                <dd class="text-chalk">cookieless · self-proxied</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">source</dt>
                <dd>
                  <a
                    href={repoUrl}
                    rel="noopener"
                    target="_blank"
                    class="inline-flex min-h-11 items-center text-amber hover:underline"
                  >pedroestevez.com ↗</a>
                </dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">status</dt>
                <dd class="flex items-center gap-2 text-delta">
                  <span class="inline-block h-1.5 w-1.5 rounded-full bg-delta"></span>live
                </dd>
              </div>
            </dl>
            <p class="border-t border-line px-6 py-4 font-mono text-[13px] text-dim">
              // this page is the demo — see <a href="#ai" class="text-amber hover:underline">ai_projects</a>
            </p>
          </div>
        </aside>
      </div>
    </section>

    <!-- ===== STATS STRIP ===== -->
    <section aria-label="Impact statistics" class="border-y border-line bg-panel-2/60">
      <div class="mx-auto grid max-w-6xl grid-cols-2 divide-line-soft px-6 sm:px-8 md:grid-cols-5 md:divide-x">
        {stats.map((s, i) => (
          <div class:list={['px-2 py-8 md:px-6', i === stats.length - 1 && 'col-span-2 md:col-span-1']}>
            <p class="font-display text-3xl tracking-tight text-amber">
              {s.value}<span class="ml-1 font-mono text-sm font-medium text-dim">{s.unit}</span>
            </p>
            <p class="mt-2 font-mono text-[13px] tracking-wider text-mist uppercase">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section id="about" class="py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 sm:px-8 lg:grid-cols-[1fr_0.8fr]">
        <div class="reveal">
          <p class="eyebrow">about</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Analyst by title.<br />Systems builder by habit.
          </h2>
          <div class="mt-6 space-y-4 text-[17px] leading-relaxed text-mist">
            <p>
              Eight-plus years across <span class="text-chalk">utilities, supply chain, and finance
              operations</span> — always in the same seat: the person who finds the manual process
            bleeding money and replaces it with a system that runs itself and proves it with numbers.
            </p>
            <p>
              The pattern is consistent: get the data model and the rules right first —
              <span class="text-chalk">SQL, ERDs</span>, and whatever prototype proves the logic
              fastest — then build the system that runs without me, and drive adoption until it
              sticks. Sometimes that system is a Power BI report. Sometimes it's
              <span class="text-chalk">a script, a pipeline, or an agent crew</span>.
            </p>
            <p>
              Now AI-enabled: I build working software with <span class="text-chalk">Claude Code</span> and
              design <span class="text-chalk">agentic systems</span> that turn well-written requirements
              directly into shipped tools.
            </p>
          </div>
        </div>
        <div class="reveal">
          <div class="rounded-md border border-line bg-panel p-6">
            <p class="eyebrow">shipped</p>
            <ol class="mt-6 space-y-4 font-mono text-sm">
              {shipped.map((s, i) => (
                <li class="flex items-baseline gap-3">
                  <span class="flex-none text-amber">{String(i + 1).padStart(2, '0')}</span>
                  <span class="min-w-0">
                    <span class="block text-chalk">{s.name}</span>
                    <span class="block text-[13px] leading-relaxed text-dim">{s.detail}</span>
                  </span>
                </li>
              ))}
            </ol>
            <div class="mt-6 border-t border-line-soft pt-6">
              <p class="font-mono text-[13px] tracking-wider text-dim uppercase">languages — fluent</p>
              <div class="mt-4 flex gap-2">
                {['English', 'Español', 'Português'].map((l) => (
                  <span class="rounded-sm border border-line px-3 py-1 font-mono text-[13px] text-mist">{l}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== EXPERIENCE ===== -->
    <section id="experience" class="border-t border-line-soft py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal">
          <p class="eyebrow">experience</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">The track record</h2>
        </div>
        <div class="mt-12 space-y-0">
          {experience.map((job) => (
            <article class="reveal group grid gap-3 border-t border-line-soft py-8 last:border-b md:grid-cols-[190px_1fr] md:gap-10">
              <div class="font-mono text-[13px] text-dim">
                <p class="text-amber">{job.dates}</p>
                <div class="mt-2 flex flex-wrap gap-1.5 md:flex-col md:items-start">
                  {job.chips.map((c) => (
                    <span
                      class:list={[
                        'rounded-sm border px-2 py-0.5 text-[13px]',
                        /^[−+]\$/.test(c)
                          ? 'border-delta/40 bg-delta/10 text-delta'
                          : 'border-line text-mist',
                      ]}
                    >{c}</span>
                  ))}
                </div>
              </div>
              <div>
                <h3 class="text-xl font-bold text-chalk">
                  {job.company}
                  <span class="ml-2 font-mono text-sm font-normal text-mist">· {job.role}</span>
                </h3>
                <ul class="mt-4 space-y-2.5">
                  {job.points.map((p) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-mist">
                      <span aria-hidden="true" class="mt-[0.55em] h-px w-4 flex-none bg-amber/70"></span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== SKILLS ===== -->
    <section id="skills" class="border-t border-line-soft bg-panel-2/40 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal">
          <p class="eyebrow">skills</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">The toolkit</h2>
        </div>
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {skillGroups.map((g) => (
            <div class="reveal rounded-md border border-line bg-panel p-6">
              <h3 class="font-mono text-[13px] font-semibold tracking-wider text-amber uppercase">{g.name}</h3>
              <ul class="mt-4 space-y-2.5">
                {g.items.map((item) => (
                  <li class="flex gap-2 text-sm leading-snug text-mist">
                    <span aria-hidden="true" class="mt-[0.45em] h-1 w-1 flex-none rounded-full bg-amber/70"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="reveal mt-6 grid gap-6 sm:grid-cols-2">
          <div class="rounded-md border border-line bg-panel p-6">
            <h3 class="font-mono text-[13px] font-semibold tracking-wider text-amber uppercase">Credentials</h3>
            <p class="mt-4 text-sm leading-relaxed text-mist">
              BBA, Management Information Systems — Florida International University
            </p>
            <p class="mt-2 font-mono text-[13px] leading-relaxed text-dim">
              Project Management MicroMasters (RIT) ·
              <span class="text-mist">Certified Scrum Product Owner — in progress</span>
            </p>
          </div>
          <div class="rounded-md border border-line bg-panel p-6">
            <h3 class="font-mono text-[13px] font-semibold tracking-wider text-amber uppercase">Source &amp; systems</h3>
            <p class="mt-4 text-sm leading-relaxed text-mist">
              This page: Astro 5 + Tailwind 4, cookieless analytics behind a same-origin proxy,
              every motion gated on prefers-reduced-motion. The source of this page is public —
              the build, the analytics config, the motion gating.
            </p>
            <a
              href={repoUrl}
              rel="noopener"
              target="_blank"
              class="mt-2 inline-flex min-h-11 items-center font-mono text-[13px] text-amber hover:underline"
            >github.com/pedroestevez/pedroestevez.com ↗</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== AI PROJECTS ===== -->
    <section id="ai" class="border-t border-line-soft py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal">
          <p class="eyebrow">ai_projects</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Requirements in.<br />Working software out.
          </h2>
        </div>
        <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_0.85fr] lg:items-start">
          <!-- left: stacked write-ups, no uniform card grid -->
          <div class="min-w-0 space-y-10">
            <article class="reveal border-l-2 border-amber/70 pl-6">
              <p class="font-mono text-[13px] tracking-wider text-dim uppercase">agentic system · human-gated</p>
              <h3 class="mt-4 text-xl font-bold text-chalk">Software that builds itself from agile specs</h3>
              <p class="mt-4 text-sm leading-relaxed text-mist">
                I designed the crew and the rules it runs on: roles, model routing
                (<code class="font-mono text-[13px] text-chalk">model = max(points-tier, risk-tier)</code>),
                two human gates, and file-overlap clustering that decides what can run in parallel.
                I write the specs in Linear; the crew executes them; nothing merges without my
                review. The requirements discipline of a Business Analyst, executed at machine speed.
              </p>
              <p class="mt-6 font-mono text-[13px] text-dim">
                Linear specs → agent crew → review gate → shipped
              </p>
            </article>
            <article class="reveal rounded-md border border-amber/50 bg-panel p-6 shadow-[0_0_40px_-18px_rgba(255,178,36,0.4)]">
              <p class="font-mono text-[13px] tracking-wider text-amber uppercase">live proof · you're looking at it</p>
              <h3 class="mt-4 text-xl font-bold text-chalk">Functional websites in under an hour</h3>
              <p class="mt-4 text-sm leading-relaxed text-mist">
                One structured prompt into Claude Code produced the first version of this site —
                copy, design system, responsive build, and metadata included. No template, no
                drag-and-drop builder, no week of back-and-forth.
              </p>
              <p class="mt-6 font-mono text-[13px] font-medium text-amber">
                This site started as one of them.
              </p>
            </article>
          </div>

          <!-- right: sticky artifact panel — the things a reader can inspect -->
          <aside aria-label="Inspectable artifacts" class="reveal min-w-0 lg:sticky lg:top-24">
            <div class="rounded-md border border-line bg-panel-2/90 p-6 shadow-[0_0_40px_-18px_rgba(255,178,36,0.4)]">
              <div>
                <p class="font-mono text-[13px] text-dim">spec · docs/ENGINE.md §4 — model routing</p>
                <p class="mt-4 border-l-2 border-line pl-4 font-mono text-[13px] leading-relaxed text-chalk">
                  {routingSpec}
                </p>
                <p class="mt-4 font-mono text-[13px] text-dim">// from a spec I wrote — repo not public</p>
              </div>
              <div class="mt-6 border-t border-line-soft pt-6">
                <p class="font-mono text-[13px] text-dim">source · src/layouts/Layout.astro:44-53</p>
                <pre class="artifact-pre mt-4 overflow-x-auto border-l-2 border-amber/70 pl-4 font-mono text-[13px] leading-relaxed text-chalk"><code>{posthogSnippet}</code></pre>
                <p class="mt-4 font-mono text-[13px] text-dim">
                  // <a
                    href={repoUrl}
                    rel="noopener"
                    target="_blank"
                    class="text-amber hover:underline"
                  >verbatim from this page's source ↗</a>
                </p>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ===== BOOKING APP ===== -->
    <section id="booking" class="border-t border-line-soft py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="eyebrow">booking_app — deployed, not a mockup</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Open it and book a slot.
          </h2>
          <p class="mt-6 text-[17px] leading-relaxed text-mist">
            A multi-tenant booking application — Next.js 15, Supabase with row-level security,
            one deploy that serves every customer by slug. It was specced issue by issue in
            Linear and built by the agent crew above; every change went through a review gate.
            The link below is my own tenant on it. Pick a time and it writes a real row.
          </p>
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_0.85fr] lg:items-start">
          <div class="reveal min-w-0 rounded-md border border-amber/50 bg-panel p-6 shadow-[0_0_40px_-18px_rgba(255,178,36,0.4)]">
            <p class="font-mono text-[13px] tracking-wider text-amber uppercase">live · try it</p>
            <p class="mt-4 font-mono text-[13px] break-all text-chalk">booking.aligncompass.com/pedroestevez</p>
            <div class="mt-6 flex flex-wrap items-center gap-4">
              <a
                href={bookingUrl}
                rel="noopener"
                target="_blank"
                class="cta-primary inline-flex min-h-11 items-center rounded-sm bg-amber px-6 py-4 font-mono text-sm font-semibold text-harbor"
              >book_a_slot ↗</a>
              <a
                href={bookingRepoUrl}
                rel="noopener"
                target="_blank"
                class="inline-flex min-h-11 items-center rounded-sm border border-line px-6 py-4 font-mono text-sm font-medium text-chalk transition-colors hover:border-amber hover:text-amber"
              >read_the_source ↗</a>
            </div>
          </div>

          <!-- What's real and what isn't — the same answer the app's own
               confirmation screen gives, so the two can never contradict. -->
          <aside aria-label="What is and isn't wired" class="reveal min-w-0 rounded-md border border-line bg-panel-2/90 p-6">
            <p class="font-mono text-[13px] text-dim">// status, stated plainly</p>
            <p class="mt-4 font-mono text-[13px] tracking-wider text-delta uppercase">wired</p>
            <ul class="mt-3 space-y-2">
              {bookingWired.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-mist">
                  <span aria-hidden="true" class="mt-2 h-px w-3 shrink-0 bg-delta"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p class="mt-6 font-mono text-[13px] tracking-wider text-dim uppercase">not yet</p>
            <ul class="mt-3 space-y-2">
              {bookingNotWired.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-dim">
                  <span aria-hidden="true" class="mt-2 h-px w-3 shrink-0 bg-line"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p class="mt-6 border-t border-line-soft pt-4 font-mono text-[13px] leading-relaxed text-dim">
              // the confirmation screen says the same thing — if you book, it tells you
              outright that no email went out and nobody was notified
            </p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ===== SERVICES ===== -->
    <section id="services" class="border-t border-line-soft bg-panel-2/40 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="eyebrow">services — fixed scope</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">Productized data services</h2>
          <p class="mt-6 text-[17px] leading-relaxed text-mist">
            Fixed prices for defined outcomes — no hourly billing, no retainers. Send your dataset
            and your question — get back a confirmed price and a delivery date. Prices are starting
            points; final scope is shaped on a free discovery call. Larger scope? Quoted as a second
            phase — never hourly. This is not staff augmentation and not an ongoing analytics
            function — it's a defined piece of work with an end date. Priced by what the work saves,
            not by hours spent.
          </p>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {services.map((s) => (
            <article class="reveal flex flex-col rounded-md border border-line bg-panel p-6 transition-colors hover:border-amber/60">
              <div class="flex items-baseline justify-between gap-3">
                <span class="rounded-sm bg-harbor px-2 py-1 font-mono text-[13px] font-semibold tracking-widest text-amber">{s.code}</span>
                <span class="text-right font-mono text-sm font-semibold text-chalk">
                  {s.price.startsWith('from') ? <><span class="text-[13px] font-medium text-dim">from </span>{s.price.slice(5)}</> : s.price}
                </span>
              </div>
              {s.priceNote && <p class="mt-1 text-right font-mono text-[13px] text-dim">{s.priceNote}</p>}
              <h3 class="mt-4 text-[17px] font-bold text-chalk">{s.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-dim">{s.desc}</p>
              {s.entry && (
                <p class="mt-2 font-mono text-[13px] leading-relaxed text-dim">{s.entry}</p>
              )}
              <ul class="mt-4 flex-1 space-y-2">
                {s.points.map((p) => (
                  <li class="flex gap-2 text-sm leading-snug text-mist">
                    <span aria-hidden="true" class="mt-[0.5em] h-px w-3.5 flex-none bg-amber/70"></span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
              <a
                href={quoteMailto(s.name)}
                class="mt-6 inline-flex min-h-11 items-center justify-center rounded-sm border border-line px-4 py-2 text-center font-mono text-[13px] font-medium text-chalk transition-colors hover:border-amber hover:text-amber"
              >Get a quote →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== CONTACT ===== -->
    <section id="contact" class="plot-grid-up relative border-t border-line-soft py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-6 sm:px-8 text-center">
        <p class="eyebrow reveal justify-center">contact</p>
        <h2 class="reveal mt-6 font-display text-[clamp(2.25rem,6vw,3rem)] leading-[1.02] tracking-tight uppercase">
          Got a messy process?<br /><span class="text-amber">Let's automate it.</span>
        </h2>
        <p class="reveal mx-auto mt-6 max-w-xl text-[17px] leading-relaxed text-mist">
          Hiring for a role, or holding a dataset that owes you answers — either way, the first
          conversation is free.
        </p>
        <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href={`mailto:${email}`}
            class="cta-primary inline-flex min-h-11 items-center rounded-sm bg-amber px-6 py-4 font-mono text-sm font-semibold text-harbor"
          >{email}</a>
          <a
            href="https://linkedin.com/in/pedro-estevez-0827a77a"
            rel="noopener"
            target="_blank"
            class="inline-flex min-h-11 items-center rounded-sm border border-line px-6 py-4 font-mono text-sm font-medium text-chalk transition-colors hover:border-amber hover:text-amber"
          >LinkedIn ↗</a>
          <a
            href={repoUrl}
            rel="noopener"
            target="_blank"
            class="inline-flex min-h-11 items-center rounded-sm border border-line px-6 py-4 font-mono text-sm font-medium text-chalk transition-colors hover:border-amber hover:text-amber"
          >Source ↗</a>
        </div>
        <p class="reveal mt-8 font-mono text-[13px] text-dim">
          Miami, FL · working in <span class="text-mist">EN / ES / PT</span> · remote or on-site
        </p>
      </div>
    </section>
  </main>

  <footer class="border-t border-line-soft py-8">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-6 font-mono text-[13px] text-dim sm:flex-row sm:px-8">
      <p>© {new Date().getFullYear()} Pedro Estevez</p>
      <p>built_with Claude Code · first version in &lt; 60 min · <span class="text-amber">this page is the demo</span></p>
    </div>
