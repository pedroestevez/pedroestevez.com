---
import Layout from '../layouts/Layout.astro';

const email = 'pedroestevez001@gmail.com';
const repoUrl = 'https://github.com/pedroestevez/pedroestevez.com';
const bookingUrl = 'https://booking.pedroestevez.com';
const bookingRepoUrl = 'https://github.com/pedroestevez/booking-platform';
const engineRepoUrl = 'https://github.com/pedroestevez/development-engine-seed';
const hireMailto = `mailto:${email}?subject=${encodeURIComponent('Hiring inquiry: AI Workflow & Automation')}`;

const nav = [
  { href: '#about', label: 'about' },
  { href: '#booking', label: 'booking_app' },
  { href: '#engine', label: 'engine' },
  { href: '#pipeline', label: 'pipeline' },
  { href: '#adoption', label: 'adoption' },
  { href: '#ops', label: 'ops_layer' },
  { href: '#lineage', label: 'lineage' },
  { href: '#skills', label: 'skills' },
  { href: '#contact', label: 'contact' },
];

const stats = [
  { value: '459', unit: 'tests', label: 'pass · 0 skipped' },
  { value: '240', unit: 'trained', label: '16-seat cohorts' },
  { value: '$20K', unit: '/yr', label: 'eliminated · still running' },
  { value: '8+', unit: 'yrs', label: 'business analysis' },
  { value: '3', unit: 'langs', label: 'EN · ES · PT' },
];

const shipped = [
  'a live multi-tenant booking app on my own tenant',
  'an agent crew that ships a Linear backlog under two human gates',
  'the six-stage pipeline that produced this page',
  'the ops layer I run my own week on',
];

const bookingChips = [
  '459 tests pass, 0 skipped',
  '28 RLS policies',
  'isolation suite covers all 7 tables',
  'Next.js 15',
  'React 19',
  'TypeScript strict',
  'Tailwind v4',
  'Supabase Postgres',
];

const bookingWired = [
  'RLS scoping by customer_id',
  'live availability from weekly rules in the tenant’s timezone',
  'real booking row, held slot, .ics invite',
  'confirmation email to the guest plus a copy to the calendar owner',
  'multi-tenant by slug',
];

const engineHolds = [
  'catches errors humans already approved (11 of 151)',
  'executes an end-state spec (28 of 28 survived)',
  'separate seats, so review is not self-review',
];

const engineHuman = [
  'direction up front and the merge at the end are mine',
  'my own prescriptive step-by-step specs were wrong 28 times',
  'the crew cannot merge; its own push was rejected',
];

const pipelineStages = [
  'offer design',
  'brand narrative',
  'services articulation',
  'conversion copy',
  'art direction',
  'build',
];

const craft = [
  'requirements at business, functional and field level',
  'BPMN-style as-is and to-be mapping, drilling only into bottlenecks',
  'elicitation, facilitation, UAT and acceptance',
  'reframing what stakeholders ask for into what they need',
];

const lineage = [
  {
    header: '2017–2019 · Wythe Capital Trust · Data Analyst',
    body: 'Selenium-automated extraction pipelines feeding SQL and statistical analysis for real-estate lead targeting. Salesforce data analysis and reporting only, never administration or configuration.',
  },
  {
    header: '2019–2024 · IPC, Subway’s supply chain arm · three roles',
    body: 'A multi-language legal-compliance system in Excel, VBA and Power Query, documented end to end in Visio. An MDM vendor transition with a managed cutover. Automated Tableau reporting. Supporting a franchise network of 20,000-plus restaurants.',
  },
  {
    header: '2024–2026 · UDT · Business Analyst',
    body: 'Invoicing automated for an entire business unit: SQL feeding Power BI reports, proven first in Excel. $20K/yr eliminated, still running without me. A $15K/yr at-risk contract rescued. The org-wide ERD, the company-wide data strategy, and the $5K/yr routing redesign.',
  },
  {
    header: '2026 · FPL · Business Analyst II, contract',
    body: 'The GCP adoption enablement program above, built from scratch. Power Automate automating the program’s own workflows.',
  },
  {
    header: '2023 → now · LLMs',
    body: 'LLMs since 2023. Then the agent systems: the engine, the booking platform, the pipeline, the ops layer.',
  },
];

const skillGroups = [
  { name: 'Automation & AI', items: 'Claude / Claude Code · agentic system design · Power Automate · Selenium' },
  { name: 'Programming & Data', items: 'SQL (expert) · Python · Excel (expert) · Power Query · VBA' },
  { name: 'BI & Data', items: 'Power BI incl. paginated · Tableau · data modeling and ERDs · MDM · data governance' },
  { name: 'Delivery', items: 'requirements engineering · process mapping (Miro/Visio) · UAT · Scrum · Jira · Linear' },
];

const credentials = [
  'Certified Scrum Product Owner, completed August 2026',
  'BBA Management Information Systems, FIU',
  'Project Management MicroMasters, RIT',
];
---

<Layout>
  <!-- ===== NAV ===== -->
  <header class="fixed inset-x-0 top-0 z-50 border-b border-line-soft bg-harbor/85 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 sm:px-8">
      <a href="#top" class="-ml-2 inline-flex min-h-11 items-center gap-2 px-2 font-display text-[17px] tracking-tight text-chalk">
        PE<span aria-hidden="true" class="inline-block h-4 w-2 bg-amber"></span>
      </a>
      <nav aria-label="Sections" class="hidden items-center gap-3 lg:flex">
        {nav.map((n) => (
          <a
            href={n.href}
            class="inline-flex min-h-11 items-center px-1 font-mono text-[13px] text-mist transition-colors hover:text-amber"
          >{n.label}</a>
        ))}
      </nav>
      <a
        href={hireMailto}
        class="cta-primary hidden min-h-11 items-center justify-center rounded-sm bg-amber px-4 py-2 font-mono text-[13px] font-semibold text-harbor md:inline-flex"
      >hire_me</a>
      <a
        href="#contact"
        class="inline-flex min-h-11 items-center px-2 font-mono text-[13px] text-amber md:hidden"
      >contact →</a>
    </div>
  </header>

  <main id="top">
    <!-- ===== HERO ===== -->
    <section class="plot-grid relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-24">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 sm:px-8 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <p class="eyebrow">25.76°N 80.19°W</p>
          <h1 class="mt-6 font-display text-[clamp(3rem,9vw,5.5rem)] leading-[0.95] tracking-tight uppercase">
            Pedro<br />Estevez<span aria-hidden="true" class="cursor-blink ml-2 inline-block h-[0.72em] w-[0.42em] bg-amber align-baseline"></span>
            <span class="mt-6 block font-mono text-sm font-medium tracking-wide text-amber normal-case uppercase">
              AI Workflow &amp; Automation Specialist
            </span>
          </h1>
          <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-mist">
            I build agent workflows that do real work under <span class="text-chalk">human
            gates</span>, and I get the teams who did not ask for them to use them.
            <span class="text-chalk">Open the booking app and book a real slot.</span> The tests,
            the limits and the source are public.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={hireMailto}
              class="cta-primary inline-flex min-h-11 items-center rounded-sm bg-amber px-6 py-4 font-mono text-sm font-semibold text-harbor"
            >hire_me</a>
            <a
              href="#booking"
              class="inline-flex min-h-11 items-center font-mono text-[13px] text-mist underline-offset-4 transition-colors hover:text-amber hover:underline"
            >or open the booking app ↓</a>
          </div>

          <p class="mt-8 inline-flex flex-wrap items-center gap-2 rounded-full border border-delta/40 bg-delta/10 px-4 py-1.5 font-mono text-[13px] text-delta">
            <span class="pulse-dot inline-block h-2 w-2 rounded-full bg-delta"></span>
            available now · contract or full-time · remote or on-site · Miami, FL
          </p>
        </div>

        <!-- signature: site telemetry panel -->
        <aside aria-label="Site telemetry" class="reveal">
          <div class="rounded-md border border-line bg-panel-2/90 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.6)]">
            <div class="flex items-center justify-between gap-4 border-b border-line px-6 py-4">
              <span class="eyebrow">site_telemetry</span>
              <span class="font-mono text-[13px] text-dim">rev 3.0</span>
            </div>
            <dl class="divide-y divide-line-soft font-mono text-[13px]">
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">built_with</dt>
                <dd class="text-chalk">Claude Code</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">stack</dt>
                <dd class="text-chalk">Astro 5 · Tailwind 4</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">analytics</dt>
                <dd class="text-chalk">cookieless · self-proxied</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">source</dt>
                <dd>
                  <a
                    href={repoUrl}
                    rel="noopener"
                    target="_blank"
                    class="inline-flex min-h-11 items-center text-amber hover:underline"
                  >public repo ↗</a>
                </dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">tests_upstream</dt>
                <dd class="text-chalk">459</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">status</dt>
                <dd class="flex items-center gap-2 text-delta">
                  <span class="inline-block h-1.5 w-1.5 rounded-full bg-delta"></span>live
                </dd>
              </div>
            </dl>
            <p class="border-t border-line px-6 py-4 font-mono text-[13px] text-dim">
              // start at <a href="#booking" class="text-amber hover:underline">booking_app</a> ↓
            </p>
          </div>
        </aside>
      </div>
    </section>

    <!-- ===== STATS STRIP ===== -->
    <section aria-label="Impact statistics" class="border-y border-line bg-panel-2/60">
      <div class="mx-auto grid max-w-6xl grid-cols-2 divide-line-soft px-6 sm:px-8 md:grid-cols-5 md:divide-x">
        {stats.map((s, i) => (
          <div class:list={['px-2 py-8 md:px-6', i === stats.length - 1 && 'col-span-2 md:col-span-1']}>
            <p class="font-display text-3xl tracking-tight text-amber">
              {s.value}<span class="ml-1 font-mono text-sm font-medium text-dim">{s.unit}</span>
            </p>
            <p class="mt-2 font-mono text-[13px] tracking-wider text-mist uppercase">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section id="about" class="py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 sm:px-8 lg:grid-cols-[1fr_0.8fr]">
        <div class="reveal">
          <p class="eyebrow">about</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Same job since 2017.<br />The tools finally caught up.
          </h2>
          <div class="mt-6 space-y-4 text-[17px] leading-relaxed text-mist">
            <p>
              I have run the rollout for people who did not ask for one, and won over the process
              owner who did not want the change by
              <span class="text-chalk">leading with the relationship, not the analysis</span>.
            </p>
            <p>
              <span class="text-chalk">I write the specs, the acceptance criteria and the
              gates. The crew writes the code. I merge every change.</span>
            </p>
            <p>
              Eight-plus years of business analysis across utilities, supply chain and finance
              operations sits under all of it.
            </p>
          </div>
        </div>
        <div class="reveal">
          <div class="rounded-md border border-line bg-panel p-6">
            <p class="eyebrow">shipped</p>
            <ol class="mt-6 space-y-4 font-mono text-sm">
              {shipped.map((s, i) => (
                <li class="flex items-baseline gap-3">
                  <span class="flex-none text-amber">{String(i + 1).padStart(2, '0')}</span>
                  <span class="min-w-0 text-mist">{s}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BOOKING APP ===== -->
    <section id="booking" class="border-t border-line-soft py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="eyebrow">booking_app · deployed, not a mockup</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Open it and book a slot.
          </h2>
          <p class="mt-6 text-[17px] leading-relaxed text-mist">
            Live on my own tenant. <span class="text-chalk">A visitor can book a real
            slot.</span> Row-level security is enabled and forced on every table. Tenant identity
            is set server-side, never taken from the browser.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={bookingUrl}
              rel="noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center font-mono text-sm text-amber underline-offset-4 hover:underline"
            >book_a_slot ↗</a>
            <a
              href={bookingRepoUrl}
              rel="noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center font-mono text-sm text-mist underline-offset-4 transition-colors hover:text-amber hover:underline"
            >read_the_source ↗</a>
          </div>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:items-start">
          <article class="reveal rounded-md border border-amber/50 bg-panel p-6 shadow-[0_0_40px_-18px_rgba(255,178,36,0.4)]">
            <p class="font-mono text-[13px] text-dim">// the numbers, and the test that tries to break them</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {bookingChips.map((c) => (
                <span class="rounded-sm border border-line px-2 py-0.5 font-mono text-[13px] text-mist">{c}</span>
              ))}
            </div>
            <p class="mt-5 text-sm leading-relaxed text-mist">
              Revert the isolation migration and <span class="text-chalk">29 of 44 isolation
              tests fail</span>. Drop one policy and 3 of 3 fail for that table. This is the test
              that would expose the isolation if it were decorative.
            </p>
          </article>

          <article class="reveal rounded-md border border-line bg-panel p-6">
            <p class="font-mono text-[13px] text-dim">// status, stated plainly</p>
            <p class="mt-4 font-mono text-[13px] font-semibold tracking-wider text-delta uppercase">wired</p>
            <ul class="mt-3 space-y-2">
              {bookingWired.map((w) => (
                <li class="flex gap-3 text-sm leading-relaxed text-mist">
                  <span aria-hidden="true" class="mt-[0.55em] h-px w-4 flex-none bg-delta/70"></span>
                  <span>{w}</span>
                </li>
              ))}
            </ul>
            <p class="mt-5 font-mono text-[13px] font-semibold tracking-wider text-amber uppercase">not yet</p>
            <ul class="mt-3 space-y-2">
              <li class="flex gap-3 text-sm leading-relaxed text-mist">
                <span aria-hidden="true" class="mt-[0.55em] h-px w-4 flex-none bg-amber/70"></span>
                <span>online payment. Stripe Connect code is merged in the repo; the public demo is not payment-enabled.</span>
              </li>
            </ul>
          </article>
        </div>

        <p class="reveal mt-8 font-mono text-[13px] leading-relaxed text-dim">
          // I wrote the specs and acceptance criteria in Linear. The crew built it. I merged
          every change.
        </p>
      </div>
    </section>

    <!-- ===== DEVELOPMENT ENGINE ===== -->
    <section id="engine" class="border-t border-line-soft bg-panel-2/40 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="eyebrow">development_engine · public repo</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            The crew that built the booking app.
          </h2>
          <p class="mt-6 text-[17px] leading-relaxed text-mist">
            A public repo where a crew of agents ships a Linear backlog under separate builder,
            reviewer, planner, researcher, spec and security seats. Two human gates:
            <span class="text-chalk">I approve direction up front and merge every change at the
            end.</span>
          </p>
          <p class="mt-4 text-sm leading-relaxed text-mist">
            Branch protection is enforced, and proven. A direct push from the crew's own
            credentials was rejected (GH013). Routing rule:
            <code class="font-mono text-[13px] text-chalk">model = max(points-tier, risk-tier)</code>.
            Risk floors a task's treatment up.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-mist">
            151 issues audited. The agents caught 11 errors humans made or approved. I caught 4.
            My confident prescriptive spec details were wrong 28 times.
            <span class="text-chalk">My end-state specs survived 28 of 28.</span>
          </p>
          <a
            href={engineRepoUrl}
            rel="noopener"
            target="_blank"
            class="mt-6 inline-flex min-h-11 items-center font-mono text-sm text-amber underline-offset-4 hover:underline"
          >read_the_source ↗</a>
        </div>

        <div class="reveal mt-12 grid gap-6 sm:grid-cols-2 lg:max-w-4xl">
          <div class="rounded-md border border-line bg-panel p-5">
            <p class="font-mono text-[13px] font-semibold tracking-wider text-delta uppercase">// what holds</p>
            <ul class="mt-3 space-y-2">
              {engineHolds.map((r) => (
                <li class="flex gap-2 text-[13px] leading-relaxed text-mist">
                  <span aria-hidden="true" class="mt-[0.5em] h-px w-3.5 flex-none bg-delta/70"></span>
                  <span>{r}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-md border border-line bg-panel p-5">
            <p class="font-mono text-[13px] font-semibold tracking-wider text-amber uppercase">// where a human is required</p>
            <ul class="mt-3 space-y-2">
              {engineHuman.map((r) => (
                <li class="flex gap-2 text-[13px] leading-relaxed text-mist">
                  <span aria-hidden="true" class="mt-[0.5em] h-px w-3.5 flex-none bg-amber/70"></span>
                  <span>{r}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== SITE PIPELINE ===== -->
    <section id="pipeline" class="border-t border-line-soft py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="eyebrow">site_pipeline</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Discovery brief in.<br />Deployed site out.
          </h2>
          <p class="mt-6 text-[17px] leading-relaxed text-mist">
            Six stages, each with its own quality gate. Discovery brief in, deployed Astro site
            out. <span class="text-chalk">This page came through it.</span>
          </p>
        </div>
        <div class="reveal mt-10 grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:max-w-4xl">
          <div class="rounded-md border border-line bg-panel p-6">
            <ol class="space-y-2.5 font-mono text-sm">
              {pipelineStages.map((s, i) => (
                <li class="flex items-baseline gap-3">
                  <span class="flex-none text-amber">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-mist">{s}</span>
                </li>
              ))}
            </ol>
            <p class="mt-4 border-t border-line-soft pt-3 font-mono text-[13px] text-dim">
              // 04 and 05 run in parallel
            </p>
          </div>
          <div>
            <div class="border-l-2 border-amber/70 pl-6">
              <p class="font-mono text-[13px] tracking-wider text-dim uppercase">measured_time</p>
              <p class="mt-3 text-sm leading-relaxed text-mist">
                About 88 minutes, brief to deployed. <span class="text-chalk">Measured
                once.</span> A best case actually achieved, not an average.
              </p>
            </div>
            <p class="mt-6 pl-6 text-sm leading-relaxed text-mist">
              Several customer sites have shipped through it. They are public on
              <a href="https://github.com/pedroestevez" rel="noopener" target="_blank" class="text-chalk underline-offset-4 hover:text-amber hover:underline">my GitHub</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== ADOPTION ===== -->
    <section id="adoption" class="border-t border-line-soft bg-panel-2/40 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="eyebrow">adoption</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Shipped is not adopted.
          </h2>
          <p class="mt-6 border-l-2 border-amber/70 pl-4 text-[17px] leading-relaxed text-chalk">
            "The last automation project died in the sales team's hands."
          </p>
          <p class="mt-6 text-[17px] leading-relaxed text-mist">
            I build for augmentation, not replacement: the value of AI is not the cost you cut,
            it is the backlog you finally deliver and the lives you make easier, for customers
            and for the people serving them.
          </p>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:items-start">
          <article class="reveal rounded-md border border-line bg-panel p-6">
            <p class="font-mono text-[13px] tracking-wider text-dim uppercase">enablement · built from scratch</p>
            <p class="mt-4 text-sm leading-relaxed text-mist">
              I ran change management and user adoption for a GCP enablement program I built
              from scratch at FPL.
              <span class="text-chalk">Trained 240 people in 16-seat cohorts.</span> Stood up a
              community of practice that outlived the engagement. Automated the program's own
              workflows with Power Automate.
            </p>
          </article>
          <article class="reveal rounded-md border border-line bg-panel p-6">
            <p class="font-mono text-[13px] tracking-wider text-dim uppercase">resistance · relationship first</p>
            <p class="mt-4 text-sm leading-relaxed text-mist">
              A reverse-logistics routing redesign at UDT removed $5K/yr in cost. The process
              owner resisted. <span class="text-chalk">I won them over by leading with the
              relationship, not the analysis.</span>
            </p>
          </article>
        </div>

        <div class="reveal mt-6 rounded-md border border-line bg-panel p-6">
          <p class="font-mono text-[13px] text-dim">// the craft underneath</p>
          <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {craft.map((c) => (
              <li class="flex gap-2 text-sm leading-snug text-mist">
                <span aria-hidden="true" class="mt-[0.45em] h-1 w-1 flex-none rounded-full bg-amber/70"></span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== OPS LAYER ===== -->
    <section id="ops" class="border-t border-line-soft py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="eyebrow">ops_layer</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Running on my own accounts.
          </h2>
          <p class="mt-6 text-[17px] leading-relaxed text-mist">
            How I work arrives with me, already built and running. Scheduled agent routines do
            the checking. The boards are part of it: agents read and write Linear and Todoist
            directly, file their own work, and flag anything only I can do.
          </p>
          <p class="mt-4 border-l-2 border-amber/70 pl-4 text-[17px] leading-relaxed text-chalk">
            "I don't ask it to do the work, I ask it how the work should be done."
          </p>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          <article class="reveal rounded-md border border-line bg-panel p-6">
            <p class="font-mono text-[13px] tracking-wider text-amber uppercase">daily_sweep</p>
            <p class="mt-4 text-sm leading-relaxed text-mist">
              Reconciles Gmail, Calendar and Todoist against each other, flags anything inbound
              with a clock on it, and corrects any board that disagrees with the inbox. Built
              after a missed reply cost a live opportunity.
            </p>
          </article>
          <article class="reveal rounded-md border border-line bg-panel p-6">
            <p class="font-mono text-[13px] tracking-wider text-amber uppercase">the_vault</p>
            <p class="mt-4 text-sm leading-relaxed text-mist">
              An Obsidian knowledge base my agents read and write mid-task, under provenance
              rules. Every note carries who wrote it and whether it was verified. One home per
              fact.
            </p>
          </article>
          <article class="reveal rounded-md border border-line bg-panel p-6">
            <p class="font-mono text-[13px] tracking-wider text-amber uppercase">send_gate</p>
            <p class="mt-4 text-sm leading-relaxed text-mist">
              The agents draft emails, applications and filings completely. I press send.
              <span class="text-chalk">Nothing goes out under my name without my hand.</span>
            </p>
          </article>
        </div>

        <p class="reveal mt-8 font-mono text-[13px] leading-relaxed text-dim">
          // every one of these drafts. none of them sends. I press send. · daily_tools: Claude
          and Claude Code, OpenAI / ChatGPT, Perplexity, Grok
        </p>
      </div>
    </section>

    <!-- ===== LINEAGE ===== -->
    <section id="lineage" class="border-t border-line-soft bg-panel-2/40 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="eyebrow">lineage · 2017 → now</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Automation since 2017.<br />LLMs since 2023.
          </h2>
        </div>
        <div class="mt-12 space-y-0 lg:max-w-4xl">
          {lineage.map((entry) => (
            <article class="reveal grid gap-2 border-t border-line-soft py-6 last:border-b md:grid-cols-[280px_1fr] md:gap-10">
              <p class="font-mono text-[13px] leading-relaxed text-amber">{entry.header}</p>
              <p class="text-sm leading-relaxed text-mist">{entry.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== SKILLS ===== -->
    <section id="skills" class="border-t border-line-soft py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal">
          <p class="eyebrow">skills</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">The toolkit</h2>
        </div>
        <div class="mt-12 grid gap-6 sm:grid-cols-2">
          {skillGroups.map((g) => (
            <div class="reveal rounded-md border border-line bg-panel p-6">
              <h3 class="font-mono text-[13px] font-semibold tracking-wider text-amber uppercase">{g.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-mist">{g.items}</p>
            </div>
          ))}
        </div>
        <div class="reveal mt-6 rounded-md border border-line bg-panel p-6 lg:max-w-2xl">
          <h3 class="font-mono text-[13px] font-semibold tracking-wider text-amber uppercase">Credentials</h3>
          <ul class="mt-3 space-y-1.5">
            {credentials.map((c) => (
              <li class="text-sm leading-relaxed text-mist">{c}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== CONTACT ===== -->
    <section id="contact" class="plot-grid-up relative border-t border-line-soft py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-6 sm:px-8 text-center">
        <p class="eyebrow reveal justify-center">contact</p>
        <h2 class="reveal mt-6 font-display text-[clamp(2.25rem,6vw,3rem)] leading-[1.02] tracking-tight uppercase">
          Is this the seat<br /><span class="text-amber">you are filling?</span>
        </h2>
        <p class="reveal mx-auto mt-6 max-w-xl text-[17px] leading-relaxed text-mist">
          The risk is not a bad hire. It is another quarter with a demo behind you and nothing
          your team uses.
        </p>
        <p class="reveal mx-auto mt-4 max-w-xl font-mono text-[13px] leading-relaxed text-dim">
          Send one email. Subject line: Hiring inquiry: AI Workflow &amp; Automation.
        </p>
        <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href={hireMailto}
            class="cta-primary inline-flex min-h-11 items-center rounded-sm bg-amber px-6 py-4 font-mono text-sm font-semibold text-harbor"
          >hire_me</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line-soft py-8">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-6 font-mono text-[13px] text-dim sm:flex-row sm:px-8">
      <p>© {new Date().getFullYear()} Pedro Estevez</p>
      <p>built_with Claude Code · shipped by the six-stage pipeline · <span class="text-amber">this page is the demo</span></p>
    </div>
  </footer>
</Layout>
