---
import Layout from '../layouts/Layout.astro';

const email = 'pedroestevez001@gmail.com';
const repoUrl = 'https://github.com/pedroestevez/pedroestevez.com';
const bookingUrl = 'https://booking.pedroestevez.com';
const bookingRepoUrl = 'https://github.com/pedroestevez/booking-platform';
const engineRepoUrl = 'https://github.com/pedroestevez/development-engine-seed';
const hireMailto = `mailto:${email}?subject=${encodeURIComponent('Hiring inquiry: AI Workflow & Automation')}`;

// Quoted character-exact from src/layouts/Layout.astro:44-53 (leading indentation
// normalised). Rendered in a <pre> — do not reformat.
const posthogSnippet = `window.posthog.init(phKey, {
  api_host: phProxy || phHost,
  // With api_host proxied, the SDK can't infer where the PostHog app
  // lives — state it so toolbar/UI links resolve.
  ui_host: phHost.replace('.i.posthog.com', '.posthog.com'),
  persistence: phCookieless ? 'memory' : 'localStorage+cookie',
  person_profiles: 'identified_only',
  capture_pageview: true,
  autocapture: true,
});`;

// Quoted from docs/ENGINE.md §4 in the public Development-Engine-Seed repo.
const routingSpec =
  'Model selection: model = max(points-tier, risk-tier). A 1-point payments task still ' +
  'routes to Opus, runs the security pass, and gets stricter acceptance criteria. Risk ' +
  "floors behavior up — that's how \"needs more care\" is encoded, as gates, not an " +
  'inflated point value.';

const nav = [
  { href: '#about', label: 'about' },
  { href: '#booking', label: 'booking_app' },
  { href: '#engine', label: 'engine' },
  { href: '#pipeline', label: 'pipeline' },
  { href: '#adoption', label: 'adoption' },
  { href: '#lineage', label: 'lineage' },
  { href: '#contact', label: 'contact' },
];

const stats = [
  { value: '459', unit: 'tests', label: 'booking platform · 0 skipped' },
  { value: '$20K', unit: '/yr', label: 'invoicing cost eliminated' },
  { value: '300', unit: 'trained', label: 'GCP enablement · 16-seat cohorts' },
  { value: '$15K', unit: '/yr', label: 'at-risk contract rescued' },
  { value: '≈88', unit: 'min', label: 'brief to deployed site · measured once' },
];

// About panel — real shipped artifacts, not process steps.
const shipped = [
  {
    name: 'booking.pedroestevez.com',
    detail: 'live · book a real slot · 459 tests pass, 0 skipped · public repo',
  },
  {
    name: 'Development Engine',
    detail: 'an agent crew ships a Linear backlog through two human gates · public repo',
  },
  {
    name: 'pedroestevez.com',
    detail: 'this site, built through the six-stage pipeline · source public',
  },
  {
    name: 'Multi-language legal-compliance system',
    detail: 'Excel/VBA + Power Query · Subway supply chain, 20,000+ restaurants',
  },
];

const bookingWired = [
  'Postgres row-level security · every row scoped by customer_id',
  'Live availability from weekly rules, in the tenant’s timezone',
  'A real booking row, a held slot, and a .ics calendar invite',
  'Confirmation email to the guest, and a copy to whoever owns the calendar',
  'Multi-tenant by slug · one deploy serves every tenant',
];

const engineRuns = [
  'Builds the backlog under six seats: build, review, plan, research, spec, security',
  'Routes every issue by model = max(points-tier, risk-tier)',
  'Caught 11 errors that humans made or approved',
];

const engineNotWithout = [
  'Direction. No work runs that I have not approved up front.',
  'Merges. Every change lands through my review; branch protection turned away the crew’s own push.',
  'What done means. The acceptance criteria the crew builds to are mine.',
];

const pipelineStages = [
  { num: '01', name: 'offer_design' },
  { num: '02', name: 'brand_narrative' },
  { num: '03', name: 'services_articulation' },
  { num: '04', name: 'conversion_copy · in parallel with 05' },
  { num: '05', name: 'art_direction · in parallel with 04' },
  { num: '06', name: 'build' },
];

const craft = [
  'reframing what stakeholders ask for into what they need',
  'requirements at business, functional, and field level',
  'BPMN-style as-is and to-be mapping · drill only into the bottlenecks',
  'UAT and acceptance with the people who will live with the system',
];

const lineage = [
  {
    dates: '2017 → 2019',
    company: 'Wythe Capital Trust',
    role: 'Data Analyst',
    chips: ['Selenium', 'SQL'],
    title: 'Selenium extraction pipelines',
    points: [
      'Selenium-automated extraction pipelines feeding SQL and statistical analysis, built to target real-estate leads.',
      'The boundary, stated: Salesforce here was data analysis and reporting only. No administration, no configuration, no implementations.',
    ],
  },
  {
    dates: '2019 → 2024',
    company: 'Independent Purchasing Cooperative',
    role: 'Three roles · Subway supply chain',
    chips: ['Excel/VBA', 'Power Query', 'MDM', 'Tableau'],
    title: 'A compliance system for 20,000+ restaurants',
    points: [
      'A multi-language legal-compliance system built in Excel, VBA, and Power Query, documented end to end in Visio, supporting a franchise network of 20,000+ Subway restaurants.',
      'Same tenure: an MDM vendor transition with a managed cutover, and automated Tableau reporting.',
    ],
  },
  {
    dates: '2024 → 2026',
    company: 'United Data Technologies',
    role: 'Business Analyst',
    chips: ['−$20K/yr', '$15K/yr rescued', '−$5K/yr', 'org-wide ERD'],
    title: 'Invoicing automation that still runs without me',
    points: [
      'Customer invoicing for an entire business unit. The logic was proven in an Excel prototype first, then built as a SQL integration feeding Power BI paginated reports. It eliminated $20K a year in manual cost, and it is still running without me. That last clause is the standard I build to, not a footnote.',
      'Same seat, three more systems: a $15K a year at-risk contract rescued with a rapid Power BI build; a reverse-logistics routing redesign that took out $5K a year; the org-wide ERD and the company-wide data strategy. Three dollar figures, three separate systems.',
    ],
  },
  {
    dates: '2026',
    company: 'Florida Power & Light',
    role: 'Business Analyst II · Contract',
    chips: ['GCP', 'Power Automate'],
    title: 'An enablement program built to outlive its builder',
    points: [
      'A GCP adoption enablement program built from scratch inside a three-month contract, with the program’s own workflows automated in Power Automate.',
      'I stood up a community of practice so the program would outlive the engagement. It did. The training numbers are in the adoption section above.',
    ],
  },
  {
    dates: '2023 → now',
    company: 'LLMs',
    role: '',
    chips: ['Claude Code', 'agent crew', '459 tests'],
    title: 'Then the agent systems',
    points: [
      'LLMs arrive on this line in 2023, and this page does not stretch that in either direction.',
      'What changed is what a written requirement can become. The systems since: the Development Engine, an agent crew that ships a Linear backlog behind two human gates, both held by me; the booking platform that crew built, live with 459 automated tests passing; the website pipeline, discovery brief in, deployed Astro site out; and a daily operations layer of four scheduled agent routines. Each has its own section on this page, limits included.',
    ],
  },
];

const skillGroups = [
  {
    name: 'Automation & AI',
    items: ['Claude / Claude Code', 'Agentic system design', 'Power Automate', 'Selenium'],
  },
  {
    name: 'Programming & Data',
    items: ['SQL (expert)', 'Python', 'Excel (expert)', 'Power Query', 'VBA'],
  },
  {
    name: 'BI & Data',
    items: [
      'Power BI, incl. paginated reports',
      'Tableau',
      'Data modeling & ERDs',
      'MDM',
      'Data governance',
    ],
  },
  {
    name: 'Delivery',
    items: ['Requirements engineering', 'Process mapping (Miro / Visio)', 'UAT', 'Scrum · Jira · Linear'],
  },
];
---

<Layout>
  <!-- ===== NAV ===== -->
  <header class="fixed inset-x-0 top-0 z-50 border-b border-line-soft bg-harbor/85 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 sm:px-8">
      <a href="#top" class="-ml-2 inline-flex min-h-11 items-center gap-2 px-2 font-display text-[17px] tracking-tight text-chalk">
        PE<span aria-hidden="true" class="inline-block h-4 w-2 bg-amber"></span>
      </a>
      <nav aria-label="Sections" class="hidden items-center gap-5 md:flex">
        {nav.map((n) => (
          <a
            href={n.href}
            class="inline-flex min-h-11 items-center px-1.5 font-mono text-[13px] text-mist transition-colors hover:text-amber"
          >{n.label}</a>
        ))}
      </nav>
      <a
        href={hireMailto}
        class="cta-primary hidden min-h-11 items-center justify-center rounded-sm bg-amber px-4 py-2 font-mono text-[13px] font-semibold text-harbor md:inline-flex"
      >hire_me</a>
      <a
        href="#contact"
        class="inline-flex min-h-11 items-center px-2 font-mono text-[13px] text-amber md:hidden"
      >contact →</a>
    </div>
  </header>

  <main id="top">
    <!-- ===== HERO ===== -->
    <section class="plot-grid relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-24">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 sm:px-8 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <p class="eyebrow">Miami, FL · 25.76°N 80.19°W</p>
          <h1 class="mt-6 font-display text-[clamp(3rem,9vw,5.5rem)] leading-[0.95] tracking-tight uppercase">
            Pedro<br />Estevez<span aria-hidden="true" class="cursor-blink ml-2 inline-block h-[0.72em] w-[0.42em] bg-amber align-baseline"></span>
          </h1>
          <p class="mt-6 font-mono text-sm font-medium tracking-wide text-amber uppercase">
            AI Workflow &amp; Automation Specialist · built on 8+ yrs of business analysis
          </p>
          <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-mist">
            You already own the systems. The manual work lives in between them. I close that gap
            with <span class="text-chalk">agent workflows that build and ship</span>, a
            <span class="text-chalk">human gate</span> on anything that goes out under your name,
            and numbers that prove the change held. Eight-plus years of business analysis is how
            I find the gap in the first place.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={hireMailto}
              class="cta-primary inline-flex min-h-11 items-center rounded-sm bg-amber px-6 py-4 font-mono text-sm font-semibold text-harbor"
            >Hire me</a>
            <a
              href="#booking"
              class="inline-flex min-h-11 items-center font-mono text-[13px] text-mist underline-offset-4 transition-colors hover:text-amber hover:underline"
            >or book a real slot on the live demo ↓</a>
          </div>

          <p class="mt-8 inline-flex items-center gap-2 rounded-full border border-delta/40 bg-delta/10 px-4 py-1.5 font-mono text-[13px] text-delta">
            <span class="pulse-dot inline-block h-2 w-2 rounded-full bg-delta"></span>
            Available immediately · contract or full-time
          </p>
        </div>

        <!-- signature: site telemetry panel -->
        <aside aria-label="Site telemetry" class="reveal">
          <div class="rounded-md border border-line bg-panel-2/90 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.6)]">
            <div class="flex items-center justify-between gap-4 border-b border-line px-6 py-4">
              <span class="eyebrow">site_telemetry</span>
              <span class="font-mono text-[13px] text-dim">rev 2.0</span>
            </div>
            <dl class="divide-y divide-line-soft font-mono text-[13px]">
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">built_with</dt>
                <dd class="text-chalk">Claude Code</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">pipeline</dt>
                <dd class="text-amber">brief to deployed · ≈88 min</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">booking_app_tests</dt>
                <dd class="text-chalk">459 pass · 0 skipped</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">stack</dt>
                <dd class="text-chalk">Astro 5 · Tailwind 4</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">analytics</dt>
                <dd class="text-chalk">cookieless · self-proxied</dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">source</dt>
                <dd>
                  <a
                    href={repoUrl}
                    rel="noopener"
                    target="_blank"
                    class="inline-flex min-h-11 items-center text-amber hover:underline"
                  >pedroestevez.com ↗</a>
                </dd>
              </div>
              <div class="flex min-h-14 items-center justify-between gap-4 px-6">
                <dt class="text-dim">status</dt>
                <dd class="flex items-center gap-2 text-delta">
                  <span class="inline-block h-1.5 w-1.5 rounded-full bg-delta"></span>live
                </dd>
              </div>
            </dl>
            <p class="border-t border-line px-6 py-4 font-mono text-[13px] text-dim">
              // ≈88 min: measured once, a best case · this page came through
              <a href="#pipeline" class="text-amber hover:underline">the pipeline</a>
            </p>
          </div>
        </aside>
      </div>
    </section>

    <!-- ===== STATS STRIP ===== -->
    <section aria-label="Impact statistics" class="border-y border-line bg-panel-2/60">
      <div class="mx-auto grid max-w-6xl grid-cols-2 divide-line-soft px-6 sm:px-8 md:grid-cols-5 md:divide-x">
        {stats.map((s, i) => (
          <div class:list={['px-2 py-8 md:px-6', i === stats.length - 1 && 'col-span-2 md:col-span-1']}>
            <p class="font-display text-3xl tracking-tight text-amber">
              {s.value}<span class="ml-1 font-mono text-sm font-medium text-dim">{s.unit}</span>
            </p>
            <p class="mt-2 font-mono text-[13px] tracking-wider text-mist uppercase">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section id="about" class="py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 sm:px-8 lg:grid-cols-[1fr_0.8fr]">
        <div class="reveal">
          <p class="eyebrow">about</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Same job since 2017.<br />The tools finally caught up.
          </h2>
          <div class="mt-6 space-y-4 text-[17px] leading-relaxed text-mist">
            <p>
              Eight-plus years of business analysis across <span class="text-chalk">utilities,
              supply chain, and finance operations</span>, always in the same seat: the person who
              finds the work still being done by hand and replaces it with a system that keeps
              running. The invoicing automation that eliminated $20K a year in manual cost
              <span class="text-chalk">still runs without me</span>. That is the bar every system
              on this page has to clear.
            </p>
            <p>
              LLMs since 2023. Today that means a <span class="text-chalk">crew of Claude Code
              agents</span> that ships a Linear backlog I spec, a booking platform that is live on
              my own domain, and four scheduled routines that run my own operations. Every one of
              those systems has the same limit built in: nothing merges and nothing goes out under
              my name without my hand. <span class="text-chalk">Agents draft; I press send.</span>
            </p>
            <p>
              One habit underneath all of it: <span class="text-chalk">I don't ask it to do the
              work, I ask it how the work should be done.</span> Get the rules out of people's
              heads and into writing before anything runs. That was true of the Excel prototype
              that proved the invoicing logic first, and it is true of the acceptance criteria the
              agent crew builds against now.
            </p>
          </div>
        </div>
        <div class="reveal">
          <div class="rounded-md border border-line bg-panel p-6">
            <p class="eyebrow">shipped</p>
            <ol class="mt-6 space-y-4 font-mono text-sm">
              {shipped.map((s, i) => (
                <li class="flex items-baseline gap-3">
                  <span class="flex-none text-amber">{String(i + 1).padStart(2, '0')}</span>
                  <span class="min-w-0">
                    <span class="block text-chalk">{s.name}</span>
                    <span class="block text-[13px] leading-relaxed text-dim">{s.detail}</span>
                  </span>
                </li>
              ))}
            </ol>
            <div class="mt-6 border-t border-line-soft pt-6">
              <p class="font-mono text-[13px] tracking-wider text-dim uppercase">languages_fluent</p>
              <div class="mt-4 flex gap-2">
                {['English', 'Español', 'Português'].map((l) => (
                  <span class="rounded-sm border border-line px-3 py-1 font-mono text-[13px] text-mist">{l}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BOOKING APP ===== -->
    <section id="booking" class="border-t border-line-soft py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="eyebrow">booking_app · deployed, not a mockup</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            Open it and book a slot.
          </h2>
          <p class="mt-6 text-[17px] leading-relaxed text-mist">
            A multi-tenant booking application: Next.js 15, React 19, TypeScript strict,
            Tailwind 4, Supabase Postgres. <span class="text-chalk">Row-level security is enabled
            and forced on every table</span>, and tenant identity is set server-side, never taken
            from the browser. One deploy serves every tenant by slug.
          </p>
          <p class="mt-4 text-[17px] leading-relaxed text-mist">
            I am the product owner on this build. It was specced in Linear, with acceptance
            criteria I wrote; the agent crew in the next section built it; I merged every change.
            The link below is my own tenant on it.
            <span class="text-chalk">Pick a time and it writes a real row.</span>
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={bookingUrl}
              rel="noopener"
              target="_blank"
              class="cta-primary inline-flex min-h-11 items-center rounded-sm bg-amber px-6 py-4 font-mono text-sm font-semibold text-harbor"
            >book_a_slot ↗</a>
            <a
              href={bookingRepoUrl}
              rel="noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center rounded-sm border border-line px-6 py-4 font-mono text-sm font-medium text-chalk transition-colors hover:border-amber hover:text-amber"
            >read_the_source ↗</a>
          </div>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:items-start">
          <article class="reveal rounded-md border border-amber/50 bg-panel p-6 shadow-[0_0_40px_-18px_rgba(255,178,36,0.4)]">
            <p class="font-mono text-[13px] text-dim">// the numbers, and the test that tries to break them</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {['459 tests passing', '0 skipped', '28 RLS policies', 'all 7 tables isolated'].map((c) => (
                <span class="rounded-sm border border-line px-2 py-0.5 font-mono text-[13px] text-mist">{c}</span>
              ))}
            </div>
            <p class="mt-5 text-sm leading-relaxed text-mist">
              459 green tests only matter if they can go red. So the claim itself got tested:
              <span class="text-chalk">revert the tenant-isolation migration and 29 of 44
              isolation tests fail.</span> Drop a single policy and 3 of 3 tests for that table
              fail. That was tested, not assumed.
            </p>
          </article>

          <article class="reveal rounded-md border border-line bg-panel p-6">
            <p class="font-mono text-[13px] text-dim">// status, stated plainly</p>
            <p class="mt-4 font-mono text-[13px] font-semibold tracking-wider text-delta uppercase">wired</p>
            <ul class="mt-3 space-y-2">
              {bookingWired.map((w) => (
                <li class="flex gap-3 text-sm leading-relaxed text-mist">
                  <span aria-hidden="true" class="mt-[0.55em] h-px w-4 flex-none bg-delta/70"></span>
                  <span>{w}</span>
                </li>
              ))}
            </ul>
            <p class="mt-5 font-mono text-[13px] font-semibold tracking-wider text-amber uppercase">not yet</p>
            <ul class="mt-3 space-y-2">
              <li class="flex gap-3 text-sm leading-relaxed text-mist">
                <span aria-hidden="true" class="mt-[0.55em] h-px w-4 flex-none bg-amber/70"></span>
                <span>Online payment. The Stripe Connect (Express) code is merged in the repo; the public demo is not payment-enabled.</span>
              </li>
            </ul>
            <p class="mt-5 border-t border-line-soft pt-4 font-mono text-[13px] text-dim">
              // book a slot and check: the row is real, and no payment is taken.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== DEVELOPMENT ENGINE ===== -->
    <section id="engine" class="border-t border-line-soft bg-panel-2/40 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="reveal">
          <p class="eyebrow">development_engine · public repo</p>
          <h2 class="mt-4 font-display text-3xl tracking-tight uppercase sm:text-4xl">
            The crew that built the booking app.
          </h2>
        </div>
        <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_0.85fr] lg:items-start">
          <div class="min-w-0 space-y-8">
            <p class="reveal text-[17px] leading-relaxed text-mist">
              A crew of Claude Code agents ships a Linear backlog under separate seats: builder,
              reviewer, planner, researcher, spec, security. I hold the two human gates.
              <span class="text-chalk">I approve direction before any work starts, and I merge
              every change at the end.</span> Nothing reaches main any other way.
            </p>

            <div class="reveal border-l-2 border-amber/70 pl-6">
              <p class="font-mono text-[13px] tracking-wider text-dim uppercase">// gate two is enforced, not promised</p>
              <p class="mt-3 text-sm leading-relaxed text-mist">
                Branch protection, verified live: a direct push from the crew's own credentials
                was rejected (GH013). The merge gate is not a promise;
                <span class="text-chalk">it is a push the repo already refused.</span>
              </p>
            </div>

            <div class="reveal border-l-2 border-line pl-6">
              <p class="font-mono text-[13px] tracking-wider text-dim uppercase">audit · 151 issues</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {['11 vs 4', '28 of 28', '26 min median'].map((c) => (
                  <span class="rounded-sm border border-line px-2 py-0.5 font-mono text-[13px] text-mist">{c}</span>
                ))}
              </div>
              <p class="mt-4 text-sm leading-relaxed text-mist">
                A hostile audit of all 151 issues on the engine's board produced two findings.
                The agents caught 11 errors that humans made or approved; I caught 4. And spec
                details that prescribed the implementation with confidence were wrong 28 times,
                while <span class="text-chalk">specs that stated the end state survived 28 of
                28</span>. The specs now state what done looks like; the crew picks the route.
                Median issue execution: 26 minutes.
              </p>
            </div>

            <div class="reveal grid gap-6 sm:grid-cols-2">
              <div class="rounded-md border border-line bg-panel p-5">
                <p class="font-mono text-[13px] font-semibold tracking-wider text-delta uppercase">// runs without me</p>
                <ul class="mt-3 space-y-2">
                  {engineRuns.map((r) => (
                    <li class="flex gap-2 text-[13px] leading-relaxed text-mist">
                      <span aria-hidden="true" class="mt-[0.5em] h-px w-3.5 flex-none bg-delta/70"></span>
                      <span>{r}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="rounded-md border border-line bg-panel p-5">
